.main {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px;
}

.ble-status {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #1E222C;
  padding: 10px;
  border-radius: 8px;
  margin-bottom: 15px;
}

.status-detail {
  height: 100%;
  display: flex;
  flex-direction: row;
  column-gap: 10px;
  align-items: center;
}

.status-dot {
  width: 15px;
  height: 15px;
  border-radius: 50%;
}

.card-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  row-gap: 10px;
  padding: 10px;
  margin-bottom: 15px;
}

.card-list {
  width: 100%;
  background-color: #1E222C;
  border-radius: 8px;
  padding: 10px;
}

.device-list {
  height: 250px;
  max-height: 250px;
}

.device-item {
  width: 100%;
  display: flex;
  flex-direction: column;
  margin-bottom: 10px;
}

.device-card {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.device-detail {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.log-list {
  height: 150px;
  max-height: 150px;
}

.btn-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 30px;
}

.ctrl-btn {
  border-radius: 9999px;
  padding: 8px 0;
  border: 1px solid transparent;
  transition: all 0.15s ease;
}

.btn-quick {
  background-color: rgba(0, 153, 255, 0.15);
  border-color: rgba(0, 153, 255, 0.4);
  box-shadow: 0 4px 12px rgba(0,153,255,0.25);
}

.btn-scan {
  background-color: rgba(245, 158, 11, 0.12);
  border-color: rgba(245, 158, 11, 0.35);
  box-shadow: 0 4px 12px rgba(245,158,11,0.15);
}

.btn-start {
  background-color: rgba(34, 197, 94, 0.15);
  border-color: rgba(34, 197, 94, 0.4);
  box-shadow: 0 4px 12px rgba(34,197,94,0.25);
}

.btn-stop {
  background-color: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.4);
  color: #EF4444;
  box-shadow: 0 4px 12px rgba(239,68,68,0.25);
}
